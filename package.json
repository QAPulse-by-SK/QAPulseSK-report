{
  "name": "qapulsesk-report",
  "version": "1.0.2",
  "description": "All-in-one test reporter for Playwright, Cypress, Jest & Vitest — beautiful dark-theme HTML reports, AI failure analysis, Slack/Teams webhooks. By QAPulse by SK.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./playwright": {
      "require": "./dist/adapters/playwright.js",
      "types": "./dist/adapters/playwright.d.ts"
    },
    "./cypress": {
      "require": "./dist/adapters/cypress.js",
      "types": "./dist/adapters/cypress.d.ts"
    },
    "./jest": {
      "require": "./dist/adapters/jest.js",
      "types": "./dist/adapters/jest.d.ts"
    },
    "./vitest": {
      "require": "./dist/adapters/vitest.js",
      "types": "./dist/adapters/vitest.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "echo \"No tests yet\" && exit 0",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "qapulse",
    "test-reporter",
    "playwright-reporter",
    "cypress-reporter",
    "jest-reporter",
    "vitest-reporter",
    "html-reporter",
    "ai-testing",
    "test-automation",
    "qa"
  ],
  "author": "QAPulse by SK <contact@skakarh.com> (https://skakarh.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QAPulse-by-SK/QAPulseSK-report.git"
  },
  "homepage": "https://skakarh.com",
  "bugs": {
    "url": "https://github.com/QAPulse-by-SK/QAPulseSK-report/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.30.0",
    "cypress": ">=12.0.0",
    "jest": ">=29.0.0",
    "vitest": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": { "optional": true },
    "cypress": { "optional": true },
    "jest": { "optional": true },
    "vitest": { "optional": true }
  },
  "dependencies": {
    "open": "^9.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@playwright/test": "^1.49.0",
    "@jest/reporters": "^29.7.0",
    "vitest": "^2.0.0"
  }
}
